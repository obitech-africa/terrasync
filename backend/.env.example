ENVIRONMENT=development
DATABASE_URL=sqlite:///./terrasync.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/terrasync
CORS_ORIGINS=*

# Development/demo only. Production always requires an explicit Alembic upgrade.
AUTO_MIGRATE_DEVELOPMENT=true

LOG_LEVEL=INFO
JSON_LOGS=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
ENABLE_DOCS=true
