ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=terrasync
POSTGRES_USER=terrasync
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://terrasync:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/terrasync

# Explicit trusted origins only in production.
CORS_ORIGINS=https://field.example.com,https://ops.example.com

AUTO_MIGRATE_DEVELOPMENT=false
LOG_LEVEL=INFO
JSON_LOGS=true

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

ENABLE_DOCS=false
TRUSTED_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=127.0.0.1
